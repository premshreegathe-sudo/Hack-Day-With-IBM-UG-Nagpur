# CircuitVision AI — Environment Variables
# Copy this file to .env and fill in your credentials.
# The application runs in demo mode if no keys are configured.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── OpenAI (GPT-4o Vision + text generation) ─────────────────────────────────
# Supports both image analysis and project recommendation enhancement.
# Leave blank to run in demo mode.
OPENAI_API_KEY=

# ── IBM watsonx (alternative provider) ───────────────────────────────────────
# VISION_API_KEY=
# VISION_API_URL=
# TEXT_API_KEY=
# TEXT_API_URL=
